{
  "name": "proofbound",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @proofbound/web",
    "worker": "npm run start --workspace @proofbound/worker",
    "build": "npm run build --workspace @proofbound/web",
    "start": "npm run start --workspace @proofbound/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contract": "node scripts/contract.mjs test",
    "build:contract": "node scripts/contract.mjs build",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
