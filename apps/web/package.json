{
  "name": "@proofbound/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "cloudflare:build": "vite build",
    "cloudflare:preview": "vite preview",
    "cloudflare:deploy": "wrangler deploy",
    "pages:build": "vite build && node scripts/stage-pages.mjs",
    "pages:preview": "wrangler pages dev --cwd ../../.data/cloudflare-pages",
    "pages:deploy": "wrangler pages deploy --cwd ../../.data/cloudflare-pages"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@proofbound/shared": "*",
    "@hot-labs/near-connect": "0.12.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vinext/cloudflare": "1.3.4",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "esbuild": "0.28.2",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  }
}
