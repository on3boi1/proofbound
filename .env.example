PROOFBOUND_MODE=local
PROOFBOUND_PROVIDER=fixture
PROOFBOUND_WEB_ORIGIN=http://127.0.0.1:3000
# Optional canonical site URL for a hosted frontend. Pages sets this in apps/web/cloudflare-pages/wrangler.jsonc.
PROOFBOUND_PUBLIC_ORIGIN=
# PROOFBOUND_PUBLIC_TESTNET=1 serves finalized public reads and disables worker proxying.
PROOFBOUND_WORKER_URL=http://127.0.0.1:3001
# Server only. Set the same random 64-character hex token on both sides of a secured worker proxy.
PROOFBOUND_WORKER_PROXY_TOKEN=
# Set only after verifying the existing NEAR AI account has credits and no paid fallback.
PROOFBOUND_CREDIT_DEMO=0
PROOFBOUND_DEMO_ACCOUNTS=
PROOFBOUND_HOST=127.0.0.1
PROOFBOUND_PORT=3001
# PROOFBOUND_DB_PATH=.data/proofbound-local.sqlite
PROOFBOUND_JOB_TIMEOUT_MS=90000
PROOFBOUND_MAX_LIVE_REQUESTS=10
PROOFBOUND_MAX_LIVE_TOKENS=80000
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEAR_AI_API_KEY=
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=
NEAR_EXECUTOR_ACCOUNT_ID=
NEAR_EXECUTOR_PRIVATE_KEY=
NEAR_VERIFIER_ACCOUNT_ID=
NEAR_VERIFIER_PRIVATE_KEY=
PROOFBOUND_ALLOW_CHAIN_WRITES=0
